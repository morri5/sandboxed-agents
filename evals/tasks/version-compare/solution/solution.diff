 """Compare semantic version strings such as "1.4.2" or "2.0.0-rc.1"."""
 
 
+def _key(version: str) -> tuple[tuple[int, ...], int, list[tuple[int, int, str]]]:
+    core, _, pre = version.partition("-")
+    numbers = tuple(int(part) for part in core.split("."))
+    if not pre:
+        return numbers, 1, []
+    idents = [(0, int(p), "") if p.isdigit() else (1, 0, p) for p in pre.split(".")]
+    return numbers, 0, idents
+
