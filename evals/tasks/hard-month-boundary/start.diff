+def yearly_summary(
+    invoices: Iterable[Invoice], year: int, tz: tzinfo, currency: str = "EUR"
+) -> dict[int, Decimal]:
+    """The total invoiced in each calendar month (1 to 12) of `year`, in `tz`."""
+    totals = {month: Decimal("0.00") for month in range(1, 13)}
+    local = timezone(tz.utcoffset(datetime(year, 1, 1)) or timedelta(0))
+    for invoice in invoices:
+        issued = invoice.issued_at.astimezone(local)
+        if issued.year == year and invoice.currency == currency:
+            totals[issued.month] += invoice_total(invoice)
+    return totals
+
+
+def render_summary(year: int, currency: str, totals: dict[int, Decimal]) -> str:
+    lines = [f"Summary {year} ({currency})", ""]
+    lines += [f"{year}-{month:02d}  {format_amount(totals[month], currency):>16}" for month in totals]
+    lines += ["", f"Year:    {format_amount(sum(totals.values(), Decimal('0.00')), currency):>16}"]
+    return "\n".join(lines)
+
+
