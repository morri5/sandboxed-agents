+"""Markdown export: a table with the CSV export's columns, for wikis and tickets."""
+
+from collections.abc import Sequence
+
+from ledger.exporters import register
+from ledger.exporters.csv_export import COLUMNS, row
+from ledger.models import Invoice
+
+AMOUNTS = {"net", "tax", "total"}  # right-aligned
+
+
+def _cell(value: str) -> str:
+    return value
+
+
+def _line(cells: Sequence[str]) -> str:
+    return "| " + " | ".join(_cell(c) for c in cells) + " |"
+
+
+@register("markdown", ".md")
+def export_markdown(invoices: Sequence[Invoice]) -> str:
+    rule = "|" + "".join("---:|" if c in AMOUNTS else "---|" for c in COLUMNS)
+    lines = [_line(COLUMNS), rule] + [_line(row(invoice)) for invoice in invoices]
+    return "\n".join(lines) + "\n"
